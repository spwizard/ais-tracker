# Backend WebSocket + REST endpoints
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000

# MapLibre basemap styles (free CARTO styles by default). The app picks the
# dark style in dark mode and the light style in light mode.
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
