# Single-app deploy: the frontend is served from the same Fly app, so use
# same-origin (relative) API + WebSocket. Empty = relative — nothing to keep in
# sync with the app name. (Dev uses .env with localhost targets.)
VITE_API_URL=
VITE_WS_URL=
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
