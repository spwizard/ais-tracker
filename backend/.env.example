# ---- Sources (each runs as its own upstream connection) ----
ENABLE_AISSTREAM=true
# Fintraffic Digitraffic — free, open AIS for Finnish/Baltic waters (no key).
ENABLE_DIGITRAFFIC=true
# Kystverket — free, open AIS for Norwegian waters via raw NMEA/TCP (no key).
ENABLE_KYSTVERKET=true

# ---- AISStream ----
# Get a free key at https://aisstream.io (sign up -> create an API key).
AISSTREAM_API_KEY=

# Bounding box(es) to subscribe to, as JSON. Order is [[lat, lon], [lat, lon]]
# = [SW corner, NE corner]. Default below is the UK + English Channel.
# Multiple boxes: [[[lat,lon],[lat,lon]], [[lat,lon],[lat,lon]]]
AIS_BBOX=[[48.5, -8.0], [52.0, 2.5]]

# ---- State store ----
# Leave blank for the in-memory store (zero infra, single instance).
# Set to use Redis (persistence + geo + future multi-instance fan-out):
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ---- Behaviour ----
VESSEL_TTL_SEC=600      # drop a vessel after this many seconds of silence
TRAIL_LEN=200            # positions kept per vessel for the trail
BROADCAST_HZ=1          # how often (per second) to push batched updates

# ---- HTTP ----
# Comma-separated list, or * for any origin (dev).
CORS_ORIGINS=*
